@[reducible] def Jung5.Point : Type :=
Fin 5 → ℝ
def Jung5.l1Dist : Jung5.Point → Jung5.Point → ℝ :=
fun x y => ∑ k, abs.{0} (HSub.hSub.{0, 0, 0} (x k) (y k))
def Jung5.UnitFiniteEnclosing : Prop :=
∀ (X : Finset.{0} Jung5.Point),
  Finset.Nonempty.{0} X →
    (∀ (x : Jung5.Point),
        Membership.mem.{0, 0} X x → ∀ (y : Jung5.Point), Membership.mem.{0, 0} X y → LE.le.{0} (Jung5.l1Dist x y) 1) →
      ∃ c, ∀ (x : Jung5.Point), Membership.mem.{0, 0} X x → LE.le.{0} (Jung5.l1Dist x c) (3 / 4)
@[reducible] def Jung5.Cut : Type :=
