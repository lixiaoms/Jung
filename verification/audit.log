    (ite.{1} (Eq.{1} k 1) (ite.{1} (Eq.{1} i 0 ∨ Eq.{1} i 2) (1 / 4) (Neg.neg.{0} (1 / 4)))
      (ite.{1} (Eq.{1} k 2) (ite.{1} (Eq.{1} i 0 ∨ Eq.{1} i 3) (1 / 4) (Neg.neg.{0} (1 / 4))) 0))
