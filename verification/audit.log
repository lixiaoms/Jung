def Jung5.separates : Jung5.Cut → Fin 6 → Fin 6 → Prop :=
fun c i j => Membership.mem.{0, 0} (↑c) i ∧ j ∉ ↑c ∨ Membership.mem.{0, 0} (↑c) j ∧ i ∉ ↑c
def Jung5.balancedSupport : (Jung5.Cut → ℝ) → Finset.{0} Jung5.Cut :=
fun w => {c | Eq.{1} (Finset.card.{0} ↑c) 3 ∧ Ne.{1} (w c) 0}
